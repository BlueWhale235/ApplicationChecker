{
  "name": "application-checker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --parallel --filter @application-checker/api --filter @application-checker/web dev",
    "dev:runner": "pnpm --filter @application-checker/runner dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @application-checker/contracts build && pnpm --filter @application-checker/cookie-state build && pnpm --filter @application-checker/ai-status build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File desktopApp/build-portable.ps1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vercel/ncc": "^0.38.3",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
