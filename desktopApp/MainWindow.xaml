<Window x:Class="ApplicationChecker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="职迹"
        Icon="assets/app-icon.ico"
        Width="1320"
        Height="860"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#FFFDF8">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" />
        <Border x:Name="LoadingPanel" Background="#FFFDF8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="职迹" FontSize="28" FontWeight="SemiBold"
                           Foreground="#173E34" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="正在启动本地服务…"
                           Margin="0,14,0,0" FontSize="14" Foreground="#66736D"
                           HorizontalAlignment="Center" />
                <ProgressBar Margin="0,22,0,0" Width="260" Height="4" IsIndeterminate="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
